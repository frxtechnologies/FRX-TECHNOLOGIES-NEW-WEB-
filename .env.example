# FRX Technologies — environment variables (copy to .env.local for local work;
# set the same names in Vercel → Project → Settings → Environment Variables for
# Production AND Preview). Never commit real values.

# --- Supabase (required) ----------------------------------------------------
# Project URL and the public anon/publishable key. Both are safe to expose to the
# browser by design: Row Level Security is the access boundary. There is NO
# service-role key anywhere in this project — do not add one.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Admin (optional; defaults to frx.technologies@gmail.com) ------------------
# Must match the email the SQL policies trust (supabase/schema.sql).
NEXT_PUBLIC_ADMIN_EMAIL=frx.technologies@gmail.com

# --- Email (Resend; optional but needed for enquiry notifications) -------------
# Server-side only; never prefix with NEXT_PUBLIC_.
# RESEND_API_KEY alone is enough for "new enquiry" emails to the owner: they are sent
# from Resend's shared sender (onboarding@resend.dev), which can deliver ONLY to the
# email address the Resend account was created with — so sign up at resend.com with
# frx.technologies@gmail.com. Without the key, enquiries are still saved in
# /admin/inquiries; the email is simply skipped.
RESEND_API_KEY=
# Needed for replying to visitors from /admin/inquiries, and to send from your own
# verified domain, e.g. "FRX Technologies <hello@frxtechnologies.com>".
RESEND_FROM_EMAIL=
# Where new-enquiry emails go. Defaults to NEXT_PUBLIC_ADMIN_EMAIL.
ENQUIRY_NOTIFY_EMAIL=

# --- Ask FRX AI assistant (Make.com) -------------------------------------------
# The webhook of the Make scenario "FRX Website Chat" (receives { message, history },
# replies with plain text). Server-side only: anyone who has this URL can call the
# scenario directly and spend its AI credits. Without it, Ask FRX falls back to its
# authored questions and answers.
ASSISTANT_WEBHOOK_URL=
